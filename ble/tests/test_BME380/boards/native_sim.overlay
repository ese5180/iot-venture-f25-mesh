/ {
    fake_i2c0: i2c@0 {
        compatible = "zephyr,i2c-emul-controller";
        reg = <0x0 0x1000>;
        #address-cells = <1>;
        #size-cells  = <0>;
        status = "okay";
        clock-frequency = <I2C_BITRATE_STANDARD>;

        mybme: bme280@76 {
            compatible = "bosch,bme280";
            reg = <0x76>;
            status = "okay";
        };
    };
};
