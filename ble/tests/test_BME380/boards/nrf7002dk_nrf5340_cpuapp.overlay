/ {
    aliases {
        led5180 = &led1;
        btn5180 = &button0;
    };
};  

&i2c1 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>; /* 100 kHz for BNO055 */

    pinctrl-0 = <&i2c1_default>;
    pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";

    mybme: mybme@77 {
        compatible = "i2c-device";
        status = "okay";
        reg = <0x77>;         
    };
    bno055: bno055@28 {
        compatible = "bosch,bno055";
        reg = <0x28>;  /* Default I2C address (COM3 pin low) */
                       /* Use 0x29 if COM3 pin is high */
        status = "okay";
    };
};

&pinctrl {
    /omit-if-no-ref/ i2c1_default: i2c1_default {
        group1 {
            /* TWIM_SCL = P1.14, TWIM_SDA = P1.15 */
            psels = <NRF_PSEL(TWIM_SCL, 1, 14)>,
                    <NRF_PSEL(TWIM_SDA, 1, 15)>;
            bias-pull-up;
        };
    };
    /omit-if-no-ref/ i2c1_sleep: i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 1, 14)>,
                    <NRF_PSEL(TWIM_SDA, 1, 15)>;
            low-power-enable;
        };
    };
};

/*
 * Device Tree Overlay for Dual SEN0209 Vibration Sensors
 * 
 * Configures two ADC channels:
 * - Channel 0: P0.04 (AIN0) for Sensor 1
 * - Channel 1: P0.05 (AIN1) for Sensor 2
 */

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* ADC Channel 0 - P0.04 (AIN0) - Sensor 1 */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <10>;
		zephyr,input-positive = <NRF_SAADC_AIN0>; /* P0.04 */
		zephyr,resolution = <12>;
	};

	/* ADC Channel 1 - P0.05 (AIN1) - Sensor 2 */
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <10>;
		zephyr,input-positive = <NRF_SAADC_AIN1>; /* P0.05 */
		zephyr,resolution = <12>;
	};
};

/* Ensure GPIO is enabled */
&gpio0 {
	status = "okay";
};

/* STEP 2.1 - Add external flash to application */
&mx25r64 {
	status = "okay";
};

/ {
	chosen {
		nordic,pm-ext-flash = &mx25r64;
	};
};
